# Local emulator only. In production the Gemini key is stored in Firebase Secret Manager,
# not here — set it once with: firebase functions:secrets:set GEMINI_API_KEY
GEMINI_API_KEY=

# Optional: override the Gemini model (defaults to gemini-3-flash-preview, same family the
# web app requests via VITE_GEMINI_MODEL).
GEMINI_MODEL=
