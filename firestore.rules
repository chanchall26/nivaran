rules_version = '2';

// Barahmasa. Everyone using the app signs in anonymously, so "signed in" means
// "using the app", not "trusted". The rules therefore validate shape and enforce
// the core policy: a report about people can never carry an enforcement route.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function str(v, max) { return v is string && v.size() <= max; }
    function isDemoDelete() { return resource.data.get('demo', false) == true; }

    match /reports/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.season in ['garmi', 'sardi']
        && request.resource.data.category in
             ['guard_fire', 'homeless', 'labour_camp', 'waste_only', 'heat_exposed', 'no_shade_spot', 'other']
        && request.resource.data.route in
             ['rwa_heater', 'shelter_outreach', 'warm_kit', 'municipal_cleanup', 'shade_water', 'plantation', 'review']
        // Madad, challan nahi: cleanup only when nobody is there
        && (request.resource.data.route != 'municipal_cleanup' || request.resource.data.peoplePresent == false)
        && request.resource.data.status == 'open'
        && request.resource.data.lat is number && request.resource.data.lon is number
        && str(request.resource.data.summary, 300)
        && (!('thumb' in request.resource.data) || str(request.resource.data.thumb, 400000))
        && (!('note' in request.resource.data) || str(request.resource.data.note, 500));
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resolvedAt'])
        && request.resource.data.status in ['open', 'assigned', 'resolved'];
      allow delete: if signedIn() && isDemoDelete();
    }

    match /deliveries/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.item in ['heater', 'warm_kit', 'cabin', 'shade_net', 'water_pot', 'sapling']
        && request.resource.data.qty is int && request.resource.data.qty > 0 && request.resource.data.qty <= 500;
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'deliveredAt', 'lastPulseAt', 'lastReason']);
      allow delete: if signedIn() && isDemoDelete();
    }

    match /pulses/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && str(request.resource.data.answer, 1000);
      allow delete: if signedIn() && isDemoDelete();
    }
  }
}
