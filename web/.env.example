# Copy to .env.local and fill in. Every key is optional: without them the app runs
# in demo mode (browser storage + rule-based AI fallback + MapLibre/OSM basemap).

# Firebase web config (Project settings -> Your apps -> Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check (required by Firebase AI Logic): reCAPTCHA Enterprise site key, and a
# debug token registered in App Check for localhost development
VITE_RECAPTCHA_SITE_KEY=
VITE_APPCHECK_DEBUG_TOKEN=

# Gemini model used through Firebase AI Logic (enable "Gemini Developer API" in the console)
VITE_GEMINI_MODEL=gemini-3-flash-preview

# Google Maps JavaScript API key (optional; falls back to MapLibre + OpenFreeMap)
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=
